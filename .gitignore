# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
out/
build/
release/
*.tsbuildinfo

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 环境与密钥（绝不能提交）
.env
.env.*
!.env.example
*.pem
*.key

# 本地运行时数据（记忆数据库、配置、日志）
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3
data/
config.local.json

# 用户私有宠物资源（可能是用户自购/自绘素材，不随仓库分发）
assets/pets/*/
!assets/pets/example/

# 验证程序的临时产物
verify/.tmp-*.png
verify/*.log

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# 测试与覆盖率
coverage/
.nyc_output/
playwright-report/
test-results/

# 开发期诊断产物
#
# `docs/evidence/` 下的**证据**（PNG 截图、clickthrough.log）是要提交的：
# 它们是 `docs/verify-m1.md` 里结论的凭据，删掉就等于结论没有支撑。
# 但每次跑应用都会产生一份运行日志，那个不该进仓库——
# 所以运行期日志统一落到 `runtime/` 子目录并被忽略。
#
# ⚠️ 注意这里**没有**用 `docs/evidence/runtime/`（带尾斜杠 = 整个目录排除）。
#    Git 的否定规则**无法重新包含一个已被排除目录里面的文件**——
#    实测：写了 `!docs/evidence/runtime/ledger/**` 也照样被忽略，
#    因为 Git 根本不会往被排除的目录里看。所以必须先放行目录本身，
#    再逐条排除里面的内容。
docs/evidence/runtime/*
!docs/evidence/runtime/ledger/
docs/evidence/probe/

# 上面第 13 行的 `*.log` 会把证据日志也一起忽略掉，这里显式放行。
# 注意顺序：`.gitignore` 的否定规则必须排在忽略规则**之后**才生效。
!docs/evidence/clickthrough.log


# 临时提交信息（用 git commit -F 时需要）
.gitmsg/

